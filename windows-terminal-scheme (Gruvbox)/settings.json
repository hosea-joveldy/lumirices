    "keybindings": [
        {
            "id": "User.newTab.Ubuntu",
            "keys": "ctrl+shift+u"
        },
        {
            "id": "User.copy",
            "keys": "ctrl+c"
        },
        {
            "id": "User.newTab.Kali",
            "keys": "ctrl+shift+k"
        },
        {
            "id": "User.paste",
            "keys": "ctrl+v"
        },
        {
            "id": "User.find",
            "keys": "ctrl+shift+f"
